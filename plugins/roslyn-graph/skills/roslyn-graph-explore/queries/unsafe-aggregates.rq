# Title: Unsafe method counts by type
# Description: count graph-exported unsafe methods per aggregated type and assembly.
PREFIX dt: <http://dotnet.example/ontology/>

SELECT ?assemblyName ?typeName (COUNT(DISTINCT ?method) AS ?unsafeMethodCount) WHERE {
  GRAPH ?g {
    ?assembly a dt:Assembly ; dt:name ?assemblyName .
    ?type dt:definedInAssembly ?assembly ; dt:fullName ?typeName ; dt:containsUnsafeCode true ;
          dt:hasMember ?method .
    ?method dt:containsUnsafeCode true .
  }
}
GROUP BY ?assemblyName ?typeName
ORDER BY ?assemblyName ?typeName
LIMIT 2000
