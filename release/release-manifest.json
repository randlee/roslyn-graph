{
  "schemaVersion": 1,
  "packageId": "RoslynToRdf",
  "versionSource": "Directory.Build.props",
  "versionProperty": "Version",
  "versionPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
  "additionalVersionSources": [
    { "path": ".claude-plugin/marketplace.json", "jsonPath": ["plugins", 0, "version"] },
    { "path": "plugins/roslyn-graph/.claude-plugin/plugin.json" },
    { "path": "plugins/roslyn-graph/.codex-plugin/plugin.json" }
  ],
  "cliProject": "src/RoslynToRdf.Cli/RoslynToRdf.Cli.csproj",
  "releaseArchives": [
    { "runtime": "win-x64", "runner": "windows-latest", "extension": "zip" },
    { "runtime": "osx-x64", "runner": "macos-15-intel", "extension": "tar.gz" },
    { "runtime": "osx-arm64", "runner": "macos-15", "extension": "tar.gz" }
  ],
  "githubPackagesSource": "https://nuget.pkg.github.com/randlee/index.json",
  "nugetOrgPublish": false
}
