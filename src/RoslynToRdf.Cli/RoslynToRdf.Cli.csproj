<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- NuGet Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>roslyn2rdf</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <!-- Package Metadata (Version/Authors/RepositoryUrl/License come from Directory.Build.props) -->
    <PackageId>RoslynToRdf</PackageId>
    <Description>Extract .NET assembly type graphs to RDF/N-Triples format for Oxigraph and other RDF databases</Description>
    <PackageTags>roslyn;rdf;ntriples;oxigraph;sparql;code-analysis;type-graph</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoslynToRdf.Core\RoslynToRdf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.9.2" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- The NuGet tool must carry the complete plugin bundle beside its entry point. -->
    <None Include="..\..\plugins\roslyn-graph\**\*"
          Pack="true"
          PackagePath="tools\net8.0\any\roslyn-graph\%(RecursiveDir)%(Filename)%(Extension)"
          Link="roslyn-graph\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
